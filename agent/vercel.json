{
  "crons": [
    {
      "path": "/api/daily",
      "schedule": "0 15 * * *"
    },
    {
      "path": "/api/daily-retry",
      "schedule": "0 17 * * *"
    },
    {
      "path": "/api/competitive-once",
      "schedule": "25 19 * * *"
    }
  ],
  "functions": {
    "api/daily.js": {
      "maxDuration": 300
    },
    "api/daily-retry.js": {
      "maxDuration": 300
    },
    "api/telegram.js": {
      "maxDuration": 300
    },
    "api/competitive-once.js": {
      "maxDuration": 300
    },
    "api/catalog-worker.js": {
      "maxDuration": 300
    },
    "api/catalog-queue.js": {
      "maxDuration": 300,
      "experimentalTriggers": [
        {
          "topic": "catalog-scan",
          "type": "queue/v2beta",
          "retryAfterSeconds": 60
        }
      ]
    }
  }
}
